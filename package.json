{
  "name": "userscript-slim-search-highlight",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --check userscript/slim-search-highlight.user.js",
    "test": "npm run check && node tests/run_tests.js",
    "test:selection": "npm run check && node tests/run_tests.js -k selection_",
    "test:features": "npm run check && node tests/run_tests.js -k feature_",
    "benchmark": "node scripts/benchmark.cjs",
    "screenshots": "npm run check && node scripts/screenshots.cjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
